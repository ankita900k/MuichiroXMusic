# Required: private owner account (full dashboard access)
MONITOR_OWNER_USERNAME=choose_a_private_owner_username
MONITOR_OWNER_PASSWORD=replace_with_a_long_random_password

# Optional: read-only monitoring account for trusted admins
MONITOR_VIEWER_USERNAME=choose_a_readonly_username
MONITOR_VIEWER_PASSWORD=replace_with_a_different_long_random_password

# SQLite database path. On a Render persistent disk mounted at /var/data, use:
# MONITOR_DB_PATH=/var/data/muichiro_monitor.sqlite3
# Without a persistent disk, use the default local path; Render redeploys can erase it.
MONITOR_DB_PATH=monitor_logs.sqlite3
MONITOR_MAX_ENTRIES=2000
